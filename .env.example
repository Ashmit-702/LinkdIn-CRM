# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/linkedin_crm?schema=public"

# --- Auth (NextAuth / Auth.js) ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- LinkedIn data provider selection ---
# "mock"  -> uses realistic fake data, no external calls, no token required
# "apify" -> calls Apify actors for LinkedIn data
LINKEDIN_PROVIDER="mock"

# --- Apify (only required when LINKEDIN_PROVIDER=apify) ---
# Server-side only. NEVER expose this to the frontend.
APIFY_API_TOKEN=""
# Actor used to fetch a profile's public posts. Verify the actor's actual
# output schema before relying on field names — see providers/apify/README.
APIFY_POSTS_ACTOR_ID=""
# Optional: a separate actor for company page data, if used.
APIFY_COMPANY_ACTOR_ID=""

# Apify run tuning
APIFY_RUN_TIMEOUT_SECS="120"
APIFY_MAX_ITEMS_PER_SYNC="50"
